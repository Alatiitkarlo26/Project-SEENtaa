# ==============================================================
# PROJECT SEENTA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================

# Server Port (Defaults to 5000 if omitted)
PORT=5000

# Front-End Web Origin (for email action links and CORS)
FRONTEND_URL=https://projectseenta.vercel.app

# JWT Signing Secret (Generate a strong random string in production)
JWT_SECRET=your_super_secure_jwt_secret_change_in_production

# Supabase Cloud Database (PostgreSQL) & Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Nodemailer SMTP Configuration (University or Custom Mailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_pup_account@gmail.com
SMTP_PASS=your_app_specific_password_or_token
SMTP_FROM="Project SEENta System" <no-reply@pup.edu.ph>

# Optional Third-Party HTTPS Mailers (For hosting providers that block SMTP ports like Render Free Tier)
# GAS_MAILER_URL=https://script.google.com/macros/s/.../exec
# BREVO_API_KEY=xkeysib-...
